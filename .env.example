SNAPSHOT_PATH=./snapshots
PORT=4040

RECOGNITION_BACKEND=python
PYTHON_RECOGNIZER_URL=http://localhost:5055

INSIGHTFACE_MODEL=buffalo_l
INSIGHTFACE_PROVIDERS=CUDAExecutionProvider,CPUExecutionProvider

# --- ACCURACY SETTINGS ---
# Face Detection Confidence: Raised to 0.70 to stop detecting non-face objects
PYTHON_DETECTION_THRESHOLD=0.70
DETECTION_THRESHOLD=0.70

# Face Matching Similarity: Raised to 0.58 to ensure names are only matched for high-accuracy matches
PYTHON_MATCH_THRESHOLD=0.58
MATCH_THRESHOLD=0.58

# Processing resolution (default is 640x640)
INSIGHTFACE_DET_WIDTH=640
INSIGHTFACE_DET_HEIGHT=640

# --- PERFORMANCE & TIMINGS ---
STREAM_FRAME_RATE=15
# FRAME_RATE=15
FRAME_RATE=5
DETECTION_COOLDOWN_MS=10000
SNAPSHOT_COOLDOWN_MS=8000
FACEAGENT_UI_FRAME_INTERVAL_MS=100

# --- ALARM SETTINGS (Anti-False-Alarm) ---
# Wait for 3 consecutive frames of unknown faces before triggering an alarm
ALARM_UNKNOWN_CONFIRMATION_FRAMES=3
ALARM_MIN_DETECTION_CONFIDENCE=0.75
ALARM_IMMEDIATE_UNKNOWN_CONFIDENCE=0.95
ALARM_COOLDOWN_MS=1000

# Grace periods to wait for a database face match before declaring a face "unknown"
KNOWN_GRACE_MS=3000
RECOGNITION_GRACE_MS=3000

# --- OTHER CONFIGS ---
LOG_LEVEL=info
LICENSE_SECRET=atmosvia-tech-2024
ALLOW_UNLICENSED_SETUP=false
DEFAULT_TENANT_ID=default_local_tenant
AUTO_START_DETECTION=true
ALARM_ENABLED=false
FACEAGENT_AUTO_START_BACKEND=true
DETECTION_IMAGE_MAX_DIM=320


BACKUP_ENABLED=true
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_COUNT=7
# BACKUP_PATH=/optional/custom/path
